# Copy to .env for local overrides. Never commit .env.
ATLAS_DATA_DIR=var/atlas
ATLAS_MAX_ROWS=1000
ATLAS_MAX_INGEST_ROWS=1000000
ATLAS_MAX_UPLOAD_BYTES=52428800
ATLAS_NULL_ERROR_RATE=0.2
ATLAS_READ_ONLY=true
# ATLAS_MODEL_PATH=
# ATLAS_MODEL_REPO=bartowski/Phi-3.5-mini-instruct-GGUF
# ATLAS_MODEL_FILE=Phi-3.5-mini-instruct-Q4_K_M.gguf
# ATLAS_UI_DIR=ui/dist

# Hosted desk. Leave these unset on a local install: sign-in stays off and the desk stays open.
# ATLAS_AUTH_ENABLED=true
# ATLAS_STRIPE_SECRET_KEY=sk_live_...
# ATLAS_STRIPE_WEBHOOK_SECRET=whsec_...
# Public origin Stripe should return to, with no trailing slash.
# ATLAS_PUBLIC_BASE_URL=https://your-host.example

