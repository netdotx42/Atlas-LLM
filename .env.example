# Copy to .env for local overrides. Never commit .env.
ATLAS_DATA_DIR=var/atlas
ATLAS_MAX_ROWS=1000
ATLAS_MAX_INGEST_ROWS=1000000
ATLAS_MAX_UPLOAD_BYTES=52428800
ATLAS_NULL_ERROR_RATE=0.2
ATLAS_READ_ONLY=true
